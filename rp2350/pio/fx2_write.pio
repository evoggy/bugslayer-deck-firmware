;
; FX2 slave FIFO write engine — RP2350 is the IFCLK master.
;
; Pins (real GP numbers; the SDK translates for the PIO GPIO base of 16):
;   OUT  base GP32, 8 pins : FD0..FD7
;   SET  base GP41, 2 pins : bit0 = SLWR#, bit1 = PKTEND#   (both active LOW)
;   side-set  GP40         : IFCLK
;   JMP pin   GP43         : FLAGB — the FX2's EP6 *programmable-level* flag,
;                            inverted at the pad, so HIGH = room
;
; Streaming is four clk_sys cycles per byte, 2 low and 2 high, with SLWR# held
; asserted: one byte per IFCLK. At clk_sys = 150 MHz and clkdiv = 1 that is
; IFCLK 37.5 MHz -> 37.5 MB/s into the FX2, more than USB 2.0 bulk drains, so
; the engine spends real time in `stall`. tIFCLK must stay inside 20.83..200 ns
; (CBM9002A datasheet p.17, identical to the Cypress FX2LP spec).
;
; IFCLK never stops while the engine runs. The FX2's FIFO logic, including the
; AUTOIN commit of a just-filled packet, runs on IFCLK. The first version of
; this engine stalled on an empty TX FIFO with the clock frozen. The stage 1
; counter never ran dry, so it did not notice, but the block sink runs dry at
; the end of every block -- a packet boundary. There the FX2 stopped for good
; after a few dozen packets, with EP6 full and nothing going to the host. So
; the engine moves data a word at a time and checks, once per word, whether
; there is a next word (`mov x, status`, TX FIFO empty) and room for it
; (`jmp pin`). If either is missing it waits in `stall` with the clock running
; and SLWR# released. The checks fit in the IFCLK-high cycles, so the rate is
; still 4 cycles per byte.
;
; Timing at 150 MHz (6.67 ns/cycle), against the rising edge the FX2 samples on:
;   FD driven       1 cyc =  6.7 ns before  (tSFD >= 3.2 ns)   OK  (b0; 2 cyc b1-b3)
;   FD held         2 cyc = 13.3 ns after   (tFDH >= 4.5 ns)   OK
;   SLWR# asserted  3 cyc = 20.0 ns before  (tSWR >= 12.1 ns)  OK  (enter)
;   SLWR# released  3 cyc = 20.0 ns before  (tSWR >= 12.1 ns)  OK  (stall)
;   PKTEND# asserted 3 cyc = 20.0 ns before (tSPE >= 14.6 ns)  OK  (pktend)
;
; Flow control does not depend on flag timing. FLAGB is the EP6 programmable
; flag, set in the FX2 firmware to assert PF_SLACK (16) bytes before EP6 is
; full. The engine looks at it once per word, and `jmp pin` sees it a couple of
; IFCLKs late (input synchronizer 2 cycles, tXFLG up to 13.5 ns). Worst case
; that is the rest of the word it asserted in, plus one more word: at most
; 8 bytes into the 16 bytes of slack.
;
; IFCLK also has to be *running before the FX2 firmware configures its FIFO
; registers*, i.e. before FX_RESET# is released -- which `clk_only` guarantees.

.program fx2_write
.side_set 1

; Clock-only loop. No OUT, no data, cannot stall. This is what runs from
; `fx2 up` until the first `arm`, and again after `disarm`. Entry releases
; SLWR#/PKTEND# first, whatever state the engine was left in.
public clk_only:
    set pins, 0b11     side 0 [1]      ; SLWR#=1, PKTEND#=1
clk_loop:
    nop                side 1 [1]      ; 2 cyc high
    jmp clk_loop       side 0 [1]      ; 2 cyc low   -> 4 cyc

; Commit whatever is in the EP6 buffer being filled as a short packet (a
; zero-length one if it is empty: ZEROLENIN). Only entered from `stall` (or a
; restart), so no word is half written.
public pktend:
    set pins, 0b01     side 0 [2]      ; 3 cyc low : PKTEND# asserted, SLWR# not
    jmp stall          side 1 [1]      ; 2 cyc high: the FX2 commits on this edge;
                                       ; `stall` releases PKTEND#

; Leaving `stall`: assert SLWR# ahead of the first byte.
enter:
    set pins, 0b10     side 0          ; L : SLWR# asserted
public word:
    pull               side 0          ; L : never blocks, the FIFO was checked
    out pins, 8        side 0          ; L : b0 on FD
    mov x, status      side 1 [1]      ; H : FX2 latches b0. x = ~0 if the TX
                                       ;     FIFO is empty: no next word
    out pins, 8        side 0 [1]      ; L : b1
    nop                side 1 [1]      ; H
    out pins, 8        side 0 [1]      ; L : b2
    nop                side 1 [1]      ; H
    out pins, 8        side 0 [1]      ; L : b3
    jmp !x, more       side 1          ; H : there is a next word...
    jmp stall          side 1          ; H   (no: wait for one)
more:
    jmp pin, word      side 1          ; H : ...and room for it: carry on
                                       ;     (no room: fall into `stall`)

; Waiting for data and room, clock running, SLWR# and PKTEND# released.
; Every byte written so far has been latched.
.wrap_target
public stall:
    set pins, 0b11     side 0          ; L : SLWR#=1, PKTEND#=1
    mov x, status      side 0 [1]      ; L : x = ~0 if the TX FIFO is empty
    jmp !x, have_data  side 1          ; H
    jmp stall          side 1          ; H : nothing to send
have_data:
    jmp pin, enter     side 1          ; H : and room? then go
.wrap                                  ;     no room: keep waiting

% c-sdk {
#include "hardware/clocks.h"

// gpio_base for the PIO instance must be 16 before calling this.
static inline void fx2_write_program_init(PIO pio, uint sm, uint offset,
                                          uint pin_fd0,     // GP32
                                          uint pin_ifclk,   // GP40
                                          uint pin_slwr,    // GP41 (PKTEND# = +1)
                                          uint pin_flagb,   // GP43
                                          float clkdiv) {
    for (uint i = 0; i < 8; i++) pio_gpio_init(pio, pin_fd0 + i);
    pio_gpio_init(pio, pin_ifclk);
    pio_gpio_init(pio, pin_slwr);
    pio_gpio_init(pio, pin_slwr + 1);
    // FLAGB is input-only, but it still needs a function select: on RP2350 the
    // pads power up isolated and only gpio_set_function() clears ISO. Without
    // it the PIO reads a latched 0 ("EP6 full") and never leaves `stall`.
    pio_gpio_init(pio, pin_flagb);

    // The input synchronizer stays on: its 2-cycle latency is absorbed by the
    // FX2's PF slack, so there is no reason to risk metastability.

    // FLAGB is the FX2's EP6 programmable-level flag, which drives HIGH when EP6
    // is nearly full. Invert it at the pad so `jmp pin` keeps meaning "room".
    gpio_set_inover(pin_flagb, GPIO_OVERRIDE_INVERT);

    pio_sm_set_consecutive_pindirs(pio, sm, pin_fd0, 8, true);
    pio_sm_set_consecutive_pindirs(pio, sm, pin_ifclk, 3, true);   // IFCLK, SLWR#, PKTEND#
    pio_sm_set_consecutive_pindirs(pio, sm, pin_flagb, 1, false);

    pio_sm_config c = fx2_write_program_get_default_config(offset);
    sm_config_set_out_pins(&c, pin_fd0, 8);
    sm_config_set_set_pins(&c, pin_slwr, 2);
    sm_config_set_sideset_pins(&c, pin_ifclk);
    sm_config_set_jmp_pin(&c, pin_flagb);
    // Explicit PULL once per word, never autopull: an autopull OUT on an empty
    // FIFO stalls with IFCLK frozen, which the FX2 does not survive.
    sm_config_set_out_shift(&c, true /*shift_right*/, false /*autopull*/, 32);
    sm_config_set_mov_status(&c, STATUS_TX_LESSTHAN, 1);   // x = ~0 when TX FIFO empty
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);
    sm_config_set_clkdiv(&c, clkdiv);

    pio_sm_init(pio, sm, offset + fx2_write_offset_clk_only, &c);

    // Park SLWR#/PKTEND# high before the SM starts driving them; the PIO output
    // register powers up at 0, which would assert both.
    pio_sm_exec(pio, sm, pio_encode_set(pio_pins, 0b11));
}
%}
